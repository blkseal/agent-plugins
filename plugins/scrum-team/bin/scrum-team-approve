#!/usr/bin/env bash
# Human-only: the stamp it writes is the hook's proof that a person reviewed this exact diff.
set -euo pipefail

git rev-parse --git-dir >/dev/null 2>&1 || { echo "scrum-team-approve: not a git repository" >&2; exit 1; }
git diff --cached --quiet && { echo "scrum-team-approve: nothing is staged" >&2; exit 1; }

git diff --cached --stat
hash=$(git diff --cached --binary | { sha256sum 2>/dev/null || shasum -a 256; } | cut -d' ' -f1)
printf '%s\n' "$hash" > "$(git rev-parse --git-dir)/scrum-team-human-approved"
echo "scrum-team-approve: human approved staged diff ${hash:0:12}"

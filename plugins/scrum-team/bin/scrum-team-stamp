#!/usr/bin/env bash
# Hashes the staged diff so the commit hook lets only that exact, reviewed diff through.
set -euo pipefail

git rev-parse --git-dir >/dev/null 2>&1 || { echo "scrum-team-stamp: not a git repository" >&2; exit 1; }

if git diff --cached --quiet; then
  echo "scrum-team-stamp: nothing is staged; nothing to approve" >&2
  exit 1
fi

hash=$(git diff --cached --binary | { sha256sum 2>/dev/null || shasum -a 256; } | cut -d' ' -f1)
# The risk vote went to a human: the hook will also need `scrum-team-approve`.
if [ "${1:-}" = "--human-required" ]; then
  printf '%s\n' "$hash" > "$(git rev-parse --git-dir)/scrum-team-human-required"
  echo "scrum-team-stamp: staged diff ${hash:0:12} needs a human: ask them to run \`! scrum-team-approve\`"
else
  printf '%s\n' "$hash" > "$(git rev-parse --git-dir)/scrum-team-audit"
  echo "scrum-team-stamp: approved staged diff ${hash:0:12}"
fi
